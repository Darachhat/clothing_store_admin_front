{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clothing-store-admin-front",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "vars": {
    "NUXT_API_BASE": "https://api.kimvannak.store",
    "NUXT_API_BASE_AUTH": "Basic YWRtaW5fZnJvbnQ6SkN3aTRaVkFqZWVqVlpsWmVmTFJubmVvUWh0Y1NrbnlYcWtzSGd0bnhnZw==",
    "NUXT_PUBLIC_API_BASE": "/api/proxy",
    "NUXT_PUBLIC_BACKEND_BASE": "https://api.kimvannak.store",
    "NUXT_PUBLIC_APP_NAME": "Kim Vannak Store — Admin"
  }
}

