# ==============================================================================
# Clothing Store — Admin & Management Portal Environment Variables
# ==============================================================================

PORT=3001
HOST=0.0.0.0

# Public URL used by the user's browser to make API requests
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Internal backend URL used by Nuxt SSR server-side calls (if applicable)
NUXT_API_BASE=http://host.docker.internal:8000

# System credential for X-System-Authorization header (server-only, never sent to browser)
# Format: Basic <base64(client_code:secret)>  OR  Bearer <token>
# Obtain by calling POST /api/v1/systems/{code}/credentials on the backend.
NUXT_API_BASE_AUTH=

NUXT_PUBLIC_APP_NAME="Clothing Store — Admin"

